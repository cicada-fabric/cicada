# Docker Compose interpolation only. The API key is intentionally not stored here.
CICADA_DATA_ROOT=/gpu1-share/data/cicada
CICADA_IMAGE=cicada-codex:dev
CICADA_UID=1000
CICADA_GID=1000
# Optional comma-separated opaque federation relay URLs, tried in order.
# CICADA_PEER_RELAY_URLS=https://relay-a.example/v1/federation/messages,https://relay-b.example/v1/federation/messages
# Generate a VAPID pair with the documented command before enabling browser push.
# CICADA_PUSH_VAPID_PUBLIC_KEY=
# CICADA_PUSH_VAPID_PRIVATE_KEY=
# CICADA_PUSH_VAPID_SUBJECT=mailto:owner@example.com
# Connector HMAC secrets belong in the operator-owned secrets file, not here:
# CICADA_CONNECTOR_SECRET_SLACK=
# CICADA_CONNECTOR_SECRET_DISCORD=
# CICADA_CONNECTOR_SECRET_DOCUMENTS=
