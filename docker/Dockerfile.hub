# Lightweight Hub runtime. It uses the same Go service binary as the full
# development image, but deliberately contains no Codex CLI, model config,
# provider URL, or provider credentials.
FROM golang:1.27.1-alpine AS cicada-builder

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY
ARG NO_PROXY
ARG CICADA_BUILD_REVISION=unknown
ARG CICADA_BUILD_DIRTY=unknown
ARG CICADA_BUILD_SOURCE_FINGERPRINT=unknown
ARG CICADA_BUILD_CATALOG_SHA256=unknown
ARG CICADA_BUILD_VERSION=0.1.0-dev
ARG CICADA_BUILD_WEBCRYPTO_MANIFEST_SHA256=unknown

ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    all_proxy=${ALL_PROXY} \
    no_proxy=${NO_PROXY}

WORKDIR /src
RUN apk add --no-cache python3 gzip
COPY cicada-go/go.mod cicada-go/go.sum ./
RUN go mod download
COPY cicada-go/ ./
COPY scripts/write-web-panel-manifest.py /tmp/write-web-panel-manifest.py
RUN mkdir -p /src/internal/server/ui/generated \
    && GOOS=js GOARCH=wasm CGO_ENABLED=0 go build -trimpath \
       -o /tmp/cicada-webcrypto.wasm ./cmd/cicada-webcrypto \
    && runtime="$(go env GOROOT)/lib/wasm/wasm_exec.js" \
    && if [ ! -f "$runtime" ]; then runtime="$(go env GOROOT)/misc/wasm/wasm_exec.js"; fi \
    && cp "$runtime" /src/internal/server/ui/generated/wasm_exec.js \
    && gzip -n -9 -c /tmp/cicada-webcrypto.wasm > /src/internal/server/ui/generated/cicada-webcrypto.wasm.gz \
    && python3 /tmp/write-web-panel-manifest.py /src/internal/server/ui/generated "$(go version)" /tmp/cicada-webcrypto.wasm \
    && rm -f /tmp/cicada-webcrypto.wasm
RUN if [ "$CICADA_BUILD_WEBCRYPTO_MANIFEST_SHA256" != unknown ]; then \
      python3 -c 'import hashlib,sys; actual=hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest(); sys.exit(0 if actual == sys.argv[2] else 1)' \
        /src/internal/server/ui/generated/panel.manifest.json "$CICADA_BUILD_WEBCRYPTO_MANIFEST_SHA256"; \
    fi
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X github.com/cicada-ai/cicada/internal/buildinfo.Version=${CICADA_BUILD_VERSION} -X github.com/cicada-ai/cicada/internal/buildinfo.Revision=${CICADA_BUILD_REVISION} -X github.com/cicada-ai/cicada/internal/buildinfo.Dirty=${CICADA_BUILD_DIRTY} -X github.com/cicada-ai/cicada/internal/buildinfo.SourceFingerprint=${CICADA_BUILD_SOURCE_FINGERPRINT}" \
    -o /out/cicada ./cmd/cicada

# This target runs the existing real-TCP Docker Hub protocol smoke test. It is
# a build-only test image and is never used as the Hub runtime.
FROM cicada-builder AS interop-test
ARG CICADA_BUILD_REVISION=unknown
ARG CICADA_BUILD_DIRTY=unknown
ARG CICADA_BUILD_SOURCE_FINGERPRINT=unknown
ARG CICADA_BUILD_CATALOG_SHA256=unknown
ARG CICADA_BUILD_VERSION=0.1.0-dev
ARG CICADA_BUILD_WEBCRYPTO_MANIFEST_SHA256=unknown
LABEL org.opencontainers.image.title="CICADA Hub interop test runner" \
      org.opencontainers.image.revision="${CICADA_BUILD_REVISION}" \
      org.cicada.build.dirty="${CICADA_BUILD_DIRTY}" \
      org.cicada.build.source-fingerprint="${CICADA_BUILD_SOURCE_FINGERPRINT}" \
      org.cicada.client-catalog.sha256="${CICADA_BUILD_CATALOG_SHA256}"
WORKDIR /src
RUN chmod -R a+rX /src
ENTRYPOINT ["go", "test", "-json", "-p=1", "./internal/server", "./cmd/client-recovery-fixture", "-run", "^TestClientDockerHub(Smoke|RecoveryFixture)$", "-count=1"]

FROM alpine:3.24 AS hub-runtime

ARG CICADA_UID=1000
ARG CICADA_GID=1000
ARG CICADA_BUILD_REVISION=unknown
ARG CICADA_BUILD_DIRTY=unknown
ARG CICADA_BUILD_SOURCE_FINGERPRINT=unknown
ARG CICADA_BUILD_CATALOG_SHA256=unknown
ARG CICADA_BUILD_VERSION=0.1.0-dev
ARG CICADA_BUILD_WEBCRYPTO_MANIFEST_SHA256=unknown

LABEL org.opencontainers.image.title="CICADA Hub" \
      org.opencontainers.image.description="CICADA Hub HTTP service without Codex or model credentials" \
      org.opencontainers.image.version="${CICADA_BUILD_VERSION}" \
      org.opencontainers.image.revision="${CICADA_BUILD_REVISION}" \
      org.cicada.role="hub" \
      org.cicada.build.dirty="${CICADA_BUILD_DIRTY}" \
      org.cicada.build.source-fingerprint="${CICADA_BUILD_SOURCE_FINGERPRINT}" \
      org.cicada.client-catalog.sha256="${CICADA_BUILD_CATALOG_SHA256}" \
      org.cicada.build.webcrypto-manifest-sha256="${CICADA_BUILD_WEBCRYPTO_MANIFEST_SHA256}"

RUN apk add --no-cache ca-certificates \
    && addgroup -g "${CICADA_GID}" cicada \
    && adduser -D -u "${CICADA_UID}" -G cicada -h /home/cicada cicada \
    && mkdir -p /home/cicada /state /workspace \
    && chown -R cicada:cicada /home/cicada /state /workspace

COPY --from=cicada-builder /out/cicada /usr/local/bin/cicada

ENV HOME=/home/cicada \
    CICADA_STATE_DIR=/state \
    CICADA_WORKSPACE_ROOT=/workspace \
    CICADA_INTENT_PLANNER_BIN= \
    CICADA_COMPLETION_VERIFIER_BIN=

USER cicada
WORKDIR /workspace
EXPOSE 8787
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8787/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/cicada"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8787"]
